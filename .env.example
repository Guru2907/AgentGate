# LLM mode: replay (saved outputs, no key needed) | live (calls Groq)
LLM_MODE=replay

# Agent used by /api/run: fake (hard-coded, no LLM) | llm (agent.py)
AGENT=fake

# Groq (primary, free key) — confirm current tool-calling model id in the Groq console
GROQ_API_KEY=
GROQ_MODEL=

# Gemini via Google AI Studio (fallback, free key, optional)
GEMINI_API_KEY=
GEMINI_MODEL=

# SQLite path
DB_PATH=agentgate.db

# Pending REVIEW items are auto-denied after this many minutes
REVIEW_TIMEOUT_MIN=10
