# Runtime
APP_ENV=development
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173

# Agent used by /api/run: llm (agent.py) | fake (hard-coded, no LLM)
AGENT=llm
# LLM mode: replay (saved outputs, no key needed) | live (calls Groq; falls back to a saved replay if Groq fails)
LLM_MODE=replay

# Groq (primary, free key) — confirm current tool-calling model id in the Groq console
GROQ_API_KEY=
GROQ_MODEL=

# Gemini via Google AI Studio (optional)
GEMINI_API_KEY=
GEMINI_MODEL=

# SQLite path
DB_PATH=agentgate.db

# Pending REVIEW items are auto-denied after this many minutes
REVIEW_TIMEOUT_MIN=10

# SMTP is required for password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_USE_SSL=false

# Local test inbox for Email company (Mailpit). Only localhost is accepted; nothing leaves the machine.
MAILPIT_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_UI=http://localhost:8025
