# Runtime
APP_ENV=development
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173

# Agent used by /api/run: llm (agent.py) | fake (hard-coded, no LLM)
AGENT=llm
# LLM mode: replay (saved outputs, no key needed) | live (calls Groq; falls back to a saved replay if Groq fails)
LLM_MODE=replay
# 1 = one-shot; 3 = multi-step runs (read -> email), needed for the read-then-email chain demo
AGENT_STEPS=3

# Groq (free key) — confirm current tool-calling model id in the Groq console
GROQ_API_KEY=
GROQ_MODEL=

# Daily AI budget (only counted when GROQ_API_KEY is set and a live call will happen)
AI_DAILY_LIMIT_PER_USER=30
AI_DAILY_LIMIT_GLOBAL=300
# Sign-ups per hour for the whole server (on top of 8 per hour per IP)
SIGNUP_LIMIT_PER_HOUR=30

# SQLite path
DB_PATH=agentgate.db

# Pending REVIEW items are auto-denied after this many minutes
REVIEW_TIMEOUT_MIN=10

# SMTP is required for password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_USE_SSL=false

# Local test inbox for Email company (Mailpit). Only localhost is accepted; nothing leaves the machine.
MAILPIT_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_UI=http://localhost:8025

# Hosted demo (Render behind Vercel)
# Use the first X-Forwarded-For address for rate limits (set only when behind a trusted proxy)
TRUST_PROXY=false
# Recreated on every start, because the free host's disk is wiped on each deploy (password: 12+ chars)
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_NAME=Demo Judge
